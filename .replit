run = "python run.py"
entrypoint = "run.py"
modules = ["python-3.11", "web"]

hidden = [".pythonlibs", ".config", "**/__pycache__", "**/*.pyc"]

[nix]
channel = "stable-24_05"
packages = ["freetype", "glibcLocales"]

[deployment]
run = ["sh", "-c", "python run.py"]
deploymentTarget = "cloudrun"
ignorePorts = false

[[ports]]
localPort = 5000
externalPort = 80

[env]
PYTHONPATH = "${REPL_HOME}"
FLASK_APP = "run.py"
FLASK_ENV = "development"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Main Application"

[[workflows.workflow]]
name = "Main Application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python run.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
expertMode = true
